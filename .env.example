# Copie este arquivo para ".env" (uso local) ou cadastre as variáveis na Vercel:
# Project → Settings → Environment Variables.

# Conexão PostgreSQL (Neon, Supabase, Railway, Vercel Postgres etc.)
# Exemplo Neon: postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Administrador inicial — criado automaticamente no primeiro deploy, se o banco não tiver usuários.
# A senha precisa ter pelo menos 8 dígitos. Pode remover estas variáveis depois do primeiro acesso.
ADMIN_EMAIL=agencia@gmail.com
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Cleverton

# Opcional: "disable" (sem SSL) | "strict" (valida certificado) | vazio = SSL padrão para bancos hospedados
DATABASE_SSL=

# Opcional: máximo de conexões por instância (padrão 5)
DATABASE_POOL_MAX=5
